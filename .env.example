# AlchemyPOS 2 — Environment Variables
# Copy to .env and fill in your values
# setup.sh generates this automatically

# Required: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-hex-string-from-setup

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://alchemypos:alchemypos@localhost/alchemypos

# Optional: Anthropic API key for AI search + suggestions + report insights
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Flask environment (development or production)
FLASK_ENV=development

# Optional: Session timeout in hours (default 8)
SESSION_HOURS=8
